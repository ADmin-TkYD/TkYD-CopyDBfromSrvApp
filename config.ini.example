[Paths]
base_dir = c:\SoftLand Systems\SLS-Serv
# Корень бэкапов можно принудительно задать; если пусто — будет извлечен из Sls_Serv.cpy
backup_root =

[Backup]
# Интервал опроса появления любого кандидата (.dbx/.db-) в секундах
creation_retry_interval = 3
# Максимальное ожидание начала создания бэкапа (появления кандидата), секунд; 0 или пусто — бесконечно
creation_retry_timeout = 0
# Интервал опроса ожидания окончательного .dbx файла, секунд
dbx_poll_interval = 2
# Максимальное ожидание появления .dbx, секунд; 0 или пусто — бесконечно
dbx_wait_timeout = 0
# Ищем только в USER/<DB_NAME> рекурсивно
search_in_user_subdir = true

[Archive]
# Попытаться искать 7z в PATH, затем в Program Files; если не найден — использовать ZIP
prefer_7z = true
# Метод сжатия для 7z, от 0 до 9
seven_zip_compression = 9
# Папка для сохранения архива; если пустая — будет создан рядом с исходным файлом
archive_output_dir =

[Logging]
level = INFO
# Опционально: файл для логов; если пусто — только консоль
file =
